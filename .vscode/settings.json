{
  // Tailwind v4는 CSS에 @theme / @utility / @import "tailwindcss" 등을 쓰는데,
  // VSCode 내장 CSS 검사기는 이를 몰라 "알 수 없는 @규칙" 경고를 낸다.
  // globals.css를 Tailwind 언어 모드로 열어 내장 검사기를 끈다.
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "css.lint.unknownAtRules": "ignore",
  "scss.lint.unknownAtRules": "ignore",

  // 디자인 치수를 임의값(w-[313px] 등)으로 두는 건 의도된 것 — Figma Dev 모드 값과
  // 1:1로 읽히게 하려는 것이라 w-78.25 같은 canonical 변환 제안은 숨긴다.
  "tailwindCSS.lint.suggestCanonicalClasses": "ignore",
  // px-4 px-6 처럼 같은 속성이 겹치는 진짜 충돌은 계속 경고받도록 둔다(기본값 warning).
  "tailwindCSS.lint.cssConflict": "warning"
}
