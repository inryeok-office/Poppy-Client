# 이 파일을 .env.local로 복사해서 사용합니다. .env.local은 커밋되지 않습니다.
#
# NEXT_PUBLIC_ 접두사가 붙은 값은 빌드 시 브라우저 번들에 그대로 포함됩니다.
# Secret, Token, Private Key를 이 접두사가 붙은 변수에 넣지 마세요.

# 백엔드 API 주소 (Poppy-Server)
# next.config.ts가 /api 요청을 이 주소로 프록시합니다.
# 값이 없으면 프록시가 꺼지고 API 요청이 전부 404가 됩니다. (CI 빌드에서만 비어 있습니다)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
